{
  "name": "@codely/knowledge-engine",
  "version": "0.1.0",
  "description": "Codely Knowledge Engine — Memory system, hybrid retrieval, and personalization for DeepTutor-equivalent capabilities",
  "type": "module",
  "main": "dist/index.js",
